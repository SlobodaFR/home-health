{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build": "npm run compile && node scripts/copy-frontend.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "typeorm",
    "migration:generate": "npm run compile && npm run typeorm -- migration:generate -d dist/infrastructure/persistence/data-source.js",
    "migration:run": "npm run compile && npm run typeorm -- migration:run -d dist/infrastructure/persistence/data-source.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^10.0.2",
    "@openfeature/ofrep-provider": "^0.2.5",
    "@openfeature/server-sdk": "^1.23.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "posthog-node": "^5.74.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
