# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Requis - home-auth (service SSO central), client OAuth2 confidentiel
# enregistre via /admin/clients sur home-auth
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=home-health
AUTH_CLIENT_SECRET=change-me
AUTH_WEBHOOK_SECRET=change-me
# Optionnel - secret de signature du webhook de deconnexion : exactement la valeur (64 hex
# minuscules) que l'admin home-auth affiche une seule fois a la regeneration. Absent : seul l'ancien
# ?secret= est verifie. Avec le flag auth-webhook-require-signature a true : signature obligatoire
# (et, sans ce secret, tout est refuse).
AUTH_WEBHOOK_SIGNING_SECRET=

# Requis - URL publique de ce service (redirect_uri OAuth2, liens
# renvoyes dans l'OpenAPI pour home-remote-mcps)
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Requis en production (optionnel en local) - secret HMAC qui pseudonymise les
# identifiants dans les logs, aleatoire, 32 octets minimum : openssl rand -base64 48
PSEUDONYM_SECRET=

# Optionnel - feature flags home-features (OFREP). Absentes ou invalides : flags desactives,
# le defaut du code s'applique (le demarrage n'est jamais bloque). URL en https en production
# (https://features.sloboda.fr/api) ; cle d'API serveur liee a l'app et a l'environnement
# (hf_ + 64 hex).
FEATURES_OFREP_URL=
FEATURES_API_KEY=
# Pin d'urgence d'un flag, prioritaire sur home-features : FEATURES_PIN_<CLE_EN_MAJ_SNAKE>=true|false
# ex. FEATURES_PIN_AUTH_VERIFY_TOKEN_CLAIMS=false

# Optionnel - telemetrie operationnelle PostHog (runtime_health toutes les 60 s, http_request par
# route Nest ; anonyme, sans donnee personnelle). Cle absente : aucun envoi, le demarrage n'en depend pas.
POSTHOG_API_KEY=
# Hote PostHog (defaut https://eu.i.posthog.com)
POSTHOG_HOST=

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - nombre de proxys inverses de confiance (X-Forwarded-For) pour le
# rate limit : 1 en production derriere Caddy, 0 (defaut) en local.
TRUST_PROXY_HOPS=0

# Optionnel - taille max du body accepte par POST /api/health/:apiKey (octets)
MAX_PAYLOAD_SIZE=52428800

# Optionnel - replication Litestream de la DB SQLite vers MinIO (S3-compatible).
# Si MINIO_BUCKET est defini, le conteneur restaure la DB au demarrage et la
# replique en continu.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=health-db
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
