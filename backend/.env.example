# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Requis - home-auth (service SSO central), client OAuth2 confidentiel
# enregistre via /admin/clients sur home-auth
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=home-health
AUTH_CLIENT_SECRET=change-me
AUTH_WEBHOOK_SECRET=change-me

# Requis - URL publique de ce service (redirect_uri OAuth2, CORS, liens
# renvoyes dans l'OpenAPI pour home-remote-mcps)
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - taille max du body accepte par POST /health/:apiKey (octets)
MAX_PAYLOAD_SIZE=52428800

# Optionnel - replication Litestream de la DB SQLite vers MinIO (S3-compatible).
# Si MINIO_BUCKET est defini, le conteneur restaure la DB au demarrage et la
# replique en continu.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=health-db
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
